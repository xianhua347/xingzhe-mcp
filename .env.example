# Stable origin, no path or trailing slash. Use your production domain on Vercel.
PUBLIC_URL=http://localhost:8000
# Supabase Connect > Transaction pooler URI. Use SSL in production.
# The Vercel integration's POSTGRES_URL is accepted when DATABASE_URL is unset.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Generate with: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
XINGZHE_CLIENT_ID=
XINGZHE_CLIENT_SECRET=
